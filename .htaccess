# =============================================================================
# Dante Gonzales Orthodontics — static rebuild
#
# The old site was PHP; this one is static HTML. Every legacy page keeps its
# exact path — including the /blog/ subdirectory — so the whole migration is an
# extension change:
#
#     /invisalign.php                ->  /invisalign.html
#     /blog/braces-vs-invisalign.php ->  /blog/braces-vs-invisalign.html
#
# One rule covers most legacy URLs; 14 pages that were also given shorter
# slugs get an explicit 301 each (see "renamed pages" below). Nothing here
# rewrites silently — every legacy URL answers with a 301 so the ranking
# history follows it.
# =============================================================================

ErrorDocument 404 /404.html

# Serve index.html for a bare directory request.
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ---------------------------------------------------------------- host ----
  # REVIEW THIS BLOCK BEFORE DEPLOY.
  # Today both hosts answer 200 with no redirect between them, so every page is
  # indexable at two addresses. The canonical tags — on the live site and in
  # this build — say "www", so non-www folds into www. If you would rather
  # standardise on the bare domain, swap this block for the reverse and re-run
  # tools/build.js after changing the canonical host in src/pages/*.json.
  RewriteCond %{HTTP_HOST} ^drdantegonzales\.com$ [NC]
  RewriteRule ^(.*)$ https://www.drdantegonzales.com/$1 [R=301,L]

  # Force HTTPS.
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]


  # ---------------------------------------------------- moved image assets ----
  # The asset tree was reorganised (assets/img/<mixed> -> assets/<purpose>/) and
  # every file renamed to a descriptive slug. Each old path answers with a 301
  # so image-search results, hotlinks and cached pages follow the file instead
  # of 404ing. Archived files are deliberately absent: nothing references them.
  RewriteRule ^assets/img/Can\ Invisalign\ Fix\ Protruding\ Front\ Teeth\.jpg$ /assets/blog/can-invisalign-fix-protruding-front-teeth/01.jpg [R=301,L,NE]
  RewriteRule ^assets/img/Crowded\ Teeth\ Before\ and\ After\.jpg$ /assets/blog/crowded-teeth-before-and-after/01.jpg [R=301,L,NE]
  RewriteRule ^assets/img/Overbite\ vs\ Underbite\.jpg$ /assets/blog/overbite-vs-underbite/01.jpg [R=301,L,NE]
  RewriteRule ^assets/img/about/inv1\.png$ /assets/locations/dublin/braces-invisalign-01.png [R=301,L,NE]
  RewriteRule ^assets/img/about/inv2\.png$ /assets/locations/dublin/braces-invisalign-02.png [R=301,L,NE]
  RewriteRule ^assets/img/about/inv3\.png$ /assets/locations/dublin/braces-invisalign-03.png [R=301,L,NE]
  RewriteRule ^assets/img/about/inv4\.png$ /assets/locations/dublin/braces-invisalign-04.png [R=301,L,NE]
  RewriteRule ^assets/img/about/inv5\.png$ /assets/locations/dublin/braces-invisalign-05.png [R=301,L,NE]
  RewriteRule ^assets/img/about/inv6\.png$ /assets/locations/dublin/office-01.png [R=301,L,NE]
  RewriteRule ^assets/img/about/inv7\.png$ /assets/locations/dublin/office-02.png [R=301,L,NE]
  RewriteRule ^assets/img/about/inv8\.png$ /assets/locations/dublin/office-03.png [R=301,L,NE]
  RewriteRule ^assets/img/banner/banner\-1\-by\-dante\.avif$ /assets/hero/home-family-kitchen.avif [R=301,L,NE]
  RewriteRule ^assets/img/banner/slide3\.jpg$ /assets/hero/braces-vs-invisalign.jpg [R=301,L,NE]
  RewriteRule ^assets/img/banner/slide5\.jpg$ /assets/hero/surgical-orthodontics.jpg [R=301,L,NE]
  RewriteRule ^assets/img/beaf/10\.jpg$ /assets/cases/gallery-03-before-after.jpg [R=301,L,NE]
  RewriteRule ^assets/img/beaf/12\.jpg$ /assets/cases/gallery-04-before-after.jpg [R=301,L,NE]
  RewriteRule ^assets/img/beaf/3\.jpg$ /assets/cases/gallery-01-after.jpg [R=301,L,NE]
  RewriteRule ^assets/img/beaf/4\.jpg$ /assets/cases/gallery-01-before.jpg [R=301,L,NE]
  RewriteRule ^assets/img/beaf/7\.jpg$ /assets/cases/gallery-02-after.jpg [R=301,L,NE]
