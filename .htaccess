  RewriteRule ^assets/img/form/radio5\.png$ /assets/ui/quiz-option-05.png [R=301,L,NE]
  RewriteRule ^assets/img/form/radio6\.png$ /assets/ui/quiz-option-06.png [R=301,L,NE]
  RewriteRule ^assets/img/logo\-white\.png$ /assets/brand/logo-white.png [R=301,L,NE]
  RewriteRule ^assets/img/logo\.png$ /assets/brand/logo.png [R=301,L,NE]
  RewriteRule ^assets/img/logo2\.png$ /assets/brand/logo-mark.png [R=301,L,NE]
  RewriteRule ^assets/img/logos/footer1\.png$ /assets/ui/accreditation-aao.png [R=301,L,NE]
  RewriteRule ^assets/img/logos/footer2\.png$ /assets/ui/accreditation-ada.png [R=301,L,NE]
  RewriteRule ^assets/img/logos/footer3\.png$ /assets/ui/accreditation-abo.png [R=301,L,NE]
  RewriteRule ^assets/img/logos/footer4\.png$ /assets/ui/accreditation-smiles-change-lives.png [R=301,L,NE]
  RewriteRule ^assets/img/logos/footer5\.png$ /assets/ui/accreditation-sharecare.png [R=301,L,NE]
  RewriteRule ^assets/img/logos/logo1\.png$ /assets/ui/partner-invisalign.png [R=301,L,NE]
  RewriteRule ^assets/img/logos/logo2\.png$ /assets/ui/partner-invisalign-teen.png [R=301,L,NE]
  RewriteRule ^assets/img/logos/logo3\.png$ /assets/ui/partner-3m.png [R=301,L,NE]
  RewriteRule ^assets/img/logos/logo4\.png$ /assets/ui/partner-acceledent.png [R=301,L,NE]
  RewriteRule ^assets/img/logos/logo5\.png$ /assets/ui/partner-itero.png [R=301,L,NE]
  RewriteRule ^assets/img/logos/logo6\.png$ /assets/ui/partner-propel.png [R=301,L,NE]
  RewriteRule ^assets/img/logos/review1\.png$ /assets/ui/review-badge-google.png [R=301,L,NE]
  RewriteRule ^assets/img/logos/review2\.png$ /assets/ui/review-badge-facebook.png [R=301,L,NE]
  RewriteRule ^assets/img/logos/review3\.png$ /assets/ui/review-badge-facebook-reviews.png [R=301,L,NE]
  RewriteRule ^assets/img/logos/review4\.png$ /assets/ui/review-badge-healthgrades.png [R=301,L,NE]
  RewriteRule ^assets/img/metal\-braces\.jpg$ /assets/treatments/metal-braces.jpg [R=301,L,NE]
  RewriteRule ^assets/img/new\-blog\-img1\.jpeg$ /assets/blog/braces-create-small-gap-between-front-teeth-is-it-normal/01.jpeg [R=301,L,NE]
  RewriteRule ^assets/img/new\-blog\-img2\.jpeg$ /assets/blog/braces-create-small-gap-between-front-teeth-is-it-normal/02.jpeg [R=301,L,NE]
  RewriteRule ^assets/img/new\-blog\-img3\.jpeg$ /assets/blog/braces-create-small-gap-between-front-teeth-is-it-normal/03.jpeg [R=301,L,NE]
  RewriteRule ^assets/img/pdf/10\-Things\-You\-Need\-to\-Know\-about\-Your\-Orthodontist\-for\-website\.pdf$ /assets/docs/top-10-things-to-know-about-your-orthodontist.pdf [R=301,L,NE]
  RewriteRule ^assets/img/pdf/Braces_Report\-Dr\-Gonzales\.pdf$ /assets/docs/braces-report-dr-gonzales.pdf [R=301,L,NE]
  RewriteRule ^assets/img/pdf/Invisalign\-Free\-Report\.pdf$ /assets/docs/invisalign-free-report.pdf [R=301,L,NE]
  RewriteRule ^assets/img/pdf/Teledentistry\-Consultation\-Dr\-Gonzales\.pdf$ /assets/docs/teledentistry-consultation-dr-gonzales.pdf [R=301,L,NE]
  RewriteRule ^assets/img/photos/braces\-care\-760\.webp$ /assets/photos/braces-care-760.webp [R=301,L,NE]
  RewriteRule ^assets/img/photos/family\-four\-760\.webp$ /assets/photos/family-four-760.webp [R=301,L,NE]
  RewriteRule ^assets/img/photos/family\-four\.jpg$ /assets/photos/family-four.jpg [R=301,L,NE]
  RewriteRule ^assets/img/photos/family\-four\.webp$ /assets/photos/family-four.webp [R=301,L,NE]
  RewriteRule ^assets/img/photos/hero\-smile\.jpg$ /assets/photos/hero-smile.jpg [R=301,L,NE]
  RewriteRule ^assets/img/report/book\-setting\-them\-straight\.png$ /assets/photos/book-setting-them-straight.png [R=301,L,NE]
  RewriteRule ^assets/img/report/book\-setting\-them\-straight\.webp$ /assets/photos/book-setting-them-straight.webp [R=301,L,NE]
  RewriteRule ^assets/img/report/top10\-cover\.png$ /assets/photos/report-top10-cover.png [R=301,L,NE]
  RewriteRule ^assets/img/report/top10\-cover\.webp$ /assets/photos/report-top10-cover.webp [R=301,L,NE]
  RewriteRule ^assets/img/star\.png$ /assets/ui/star-rating.png [R=301,L,NE]
  RewriteRule ^assets/img/straight\-teeth\-faster\-with\-propel\-orthodontics\.jpg$ /assets/treatments/propel-accelerated-orthodontics.jpg [R=301,L,NE]
  RewriteRule ^assets/img/surgical/img4\.jpg$ /assets/treatments/surgical-orthodontics-01.jpg [R=301,L,NE]
  RewriteRule ^assets/img/tracy/img3\.jpg$ /assets/locations/tracy/sleep-apnea-tracy-01.jpg [R=301,L,NE]
  RewriteRule ^assets/img/tracy/img4\.jpg$ /assets/locations/tracy/sleep-apnea-tracy-02.jpg [R=301,L,NE]
  RewriteRule ^assets/img/video/intro\-poster\.jpg$ /assets/video/intro-poster.jpg [R=301,L,NE]
  RewriteRule ^assets/img/video/intro\-poster\.webp$ /assets/video/intro-poster.webp [R=301,L,NE]

  # --------------------------------------------------------------- pages ----
  # The homepage was reachable at both / and /index.php.
  RewriteRule ^index\.php$ / [R=301,L]

  # These three were listed in the old sitemap but were already broken in
  # production: blogs.php returned a database error, blog1.php and blog2.php
  # returned zero bytes. blogs.php was the blog index, so it goes to the blog;
  # blog1/blog2 were blank placeholder carousels with no topic, so they go home.
  RewriteRule ^blogs\.php$ /blog.html [R=301,L]
  RewriteRule ^(blog1|blog2)\.php$ / [R=301,L]

  # An unfinished SEO stub that never made it into the old sitemap but is
  # linked from the old blog index and marked "index, follow", so it may hold
  # ranking history. It has no counterpart in this build; send it to the
  # closest topic rather than letting the generic rule below 404 it.
  RewriteRule ^dealing-with-wisdom-teeth\.(php|html)$ /blog/what-causes-crowded-teeth-and-how-dentists-fix-them.html [R=301,L,NE]

  # ------------------------------------------------------ renamed pages ----
  # 14 pages were given short slugs that match their nav label. Each old slug
  # -- the legacy .php and the interim long .html -- 301s to the new file.
  # These must sit ahead of the generic .php->.html rule below, whose -f test
  # would otherwise drop them into the 404 (the old .html no longer exists).
  RewriteRule ^about\.(php|html)$ /meet-our-founder.html [R=301,L,NE]
  RewriteRule ^dublin-california-ca-orthodontics-office\.(php|html)$ /about-us.html [R=301,L,NE]
  RewriteRule ^dublin-california-ca-braces-orthodontics-and-invisalign\.(php|html)$ /braces-and-invisalign.html [R=301,L,NE]
  RewriteRule ^elite-invisalign-and-invisalign-teen-orthodontist\.(php|html)$ /invisalign-teen.html [R=301,L,NE]
  RewriteRule ^best-dublin-ca-orthodontics-office-and-orthodontist\.(php|html)$ /why-dante-gonzales.html [R=301,L,NE]
  RewriteRule ^sleep-apnea-specialist-dublin-california-ca\.(php|html)$ /sleep-apnea-treatment.html [R=301,L,NE]
  RewriteRule ^sleep-apnea-dentist-in-dublin\.(php|html)$ /sleep-apnea-dublin.html [R=301,L,NE]
  RewriteRule ^sleep-apnea-treatment-tracy\.(php|html)$ /sleep-apnea-tracy.html [R=301,L,NE]
  RewriteRule ^meet-our-orthodontists-in-dublin-ca\.(php|html)$ /meet-our-orthodontists.html [R=301,L,NE]
  RewriteRule ^meet-our-orthodontics-team\.(php|html)$ /meet-our-dublin-team.html [R=301,L,NE]
  RewriteRule ^meet-the-tracy-orthodontics-team\.(php|html)$ /meet-our-tracy-team.html [R=301,L,NE]
  RewriteRule ^dublin-ca-orthodontic-office-contact\.(php|html)$ /contact-dublin.html [R=301,L,NE]
  RewriteRule ^tracy-ca-orthodontic-office-contact\.(php|html)$ /contact-tracy.html [R=301,L,NE]
  RewriteRule ^impression-techniques-in-orthodontics\.(php|html)$ /impression-techniques.html [R=301,L,NE]

  # Two blog posts were given clearer slugs ("...-an-overbite" / "...-an-underbite").
  RewriteRule ^blog/can-invisalign-fix-overbite\.(php|html)$ /blog/can-invisalign-fix-an-overbite.html [R=301,L,NE]
  RewriteRule ^blog/can-invisalign-fix-underbite\.(php|html)$ /blog/can-invisalign-fix-an-underbite.html [R=301,L,NE]

  # best-age-for-braces was a near-duplicate of a post that did migrate - it
  # differed only in its meta title - so it still points at the surviving article.
  RewriteRule ^blog/best-age-for-braces\.(php|html)$ /blog/whats-the-best-age-for-braces.html [R=301,L,NE]

  # is-invisalign-worth-it-for-adults was previously folded into the cost/timeline
  # post. It now exists as its own page, so that consolidation redirect is gone and
  # the generic .php -> .html rule below carries the legacy URL to it.
  # NOTE: this page and invisalign-treatment-for-adults-cost-timeline.html share the
  # same body copy. They compete for the same query until one is rewritten.

  # Every other legacy page: same slug, new extension. The condition means a
  # .php URL with no matching .html falls through to the 404 instead of
  # redirecting into one.
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+)\.php$ /$1.html [R=301,L]
</IfModule>

# =============================================================================
# DELIVERY — compression, caching, security headers
#
# Everything above this line routes requests; everything below governs how the
# response is sent. All three blocks are guarded by IfModule, so a host without
# a given module serves the site unchanged rather than throwing a 500.
# =============================================================================

# ------------------------------------------------------------- compression --
# The stylesheet alone is ~228 KB uncompressed and drops to roughly a sixth of
# that gzipped. Images and fonts are already compressed formats — running them
# through DEFLATE again only burns CPU, so they are deliberately absent here.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
  AddOutputFilterByType DEFLATE application/json application/ld+json
  AddOutputFilterByType DEFLATE application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/ttf font/otf application/vnd.ms-fontobject
</IfModule>

# ------------------------------------------------------------------ caching --
# Filenames here are NOT content-hashed, so a long max-age on CSS/JS would keep
# serving a stale build to returning visitors after a deploy. Those two revalidate
# on every request instead — a 304 is a few hundred bytes and settles in one round
# trip. Images and fonts do get the long immutable cache: when one of those
# changes it is nearly always a new filename anyway.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 month"
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 0 seconds"
  ExpiresByType application/javascript    "access plus 0 seconds"
  ExpiresByType text/javascript           "access plus 0 seconds"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/avif                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/x-icon              "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType application/xml           "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  # HTML always revalidates so a content fix is live immediately.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Un-hashed CSS/JS: revalidate, but serve from cache on a 304.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|webp|avif|gif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # --------------------------------------------------------------- security --
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()"

  # Content-Security-Policy, derived from what the site actually loads:
  #   styles/fonts  -> Google Fonts (fonts.googleapis.com + fonts.gstatic.com)
  #   frame-src     -> youtube-nocookie, the player js/main.js injects on click
  #   'unsafe-inline' is required by the inline <script> blocks and JSON-LD
  #   already in the pages; removing it means moving those to files first.
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-src https://www.youtube-nocookie.com; upgrade-insecure-requests"

  # HSTS is deliberately left off. Browsers honour it for the full max-age even
  # after the header is withdrawn, so it is a one-way door: switch it on only
  # once HTTPS is confirmed good on the apex and every subdomain.
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>
